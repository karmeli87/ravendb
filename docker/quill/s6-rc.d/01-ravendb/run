#!/command/with-contenv sh
set -e

exec 2>&1

mkdir -p /var/lib/quill/ravendb

# RavenDB starts ONLY after activation has unpacked the setup package. Load-bearing, not tidiness:
# RavenDB activates the package's license.json (License.Path below) only on a start where the node is
# still Passive. A start before the package produces a cluster that bootstraps with no license - in
# the same RAVEN_DataDir, so it survives the restart - and such a node never accepts License.Path
# again. The appliance then runs unlicensed with a valid license sitting on disk.
#
#   02-web      activation downloads + unpacks the package ──┐
#   01-ravendb  waits here ◄───────────────────────────────--┘
#               then overlays the secure settings and execs Raven.Server, which is now a
#               first start on a Passive node -> the license activates.
#
# Two constraints follow:
#   - 02-web must NEVER be ordered behind this service - no dependencies.d entry, no notification-fd.
#     It is the service that produces what we wait for; ordering it after us deadlocks the container.
#   - This loop must not exit. 05-console watches this service's pid and reports a respawn as
#     "ravendb stopped unexpectedly and was restarted".
#
# The sentinel is admin-thumbprint, not A/settings.json: activation writes it after the zip is fully
# extracted, so it is the only file that means "package complete". A/settings.json can appear
# mid-unzip, before license.json exists.
SETUP_DIR="${RAVEN_QUILL_SETUP_PACKAGE_PATH:-/var/lib/quill/setup}"
SETUP_SETTINGS="$SETUP_DIR/A/settings.json"
SETUP_DONE="$SETUP_DIR/admin-thumbprint"

i=0
while [ ! -f "$SETUP_DONE" ]; do
    if [ $((i % 60)) -eq 0 ]; then
        echo "01-ravendb: waiting for the setup package at $SETUP_DIR (${i}s)."
    fi
    i=$((i + 1))
    sleep 1
done

cp "$SETUP_SETTINGS" /app/ravendb/settings.json

# Phase 1: nginx owns :443, so bind RavenDB's HTTPS to loopback:$RAVENDB_PORT instead. settings.json
# wins over env in RavenDB's config precedence, so rewrite the copied file (keep https — the
# scheme-match validator requires ServerUrl/PublicServerUrl schemes to agree). The appliance connects
# to RavenDB on this port (RavenStoreFactory.RavenInternalPort); nginx passes db.*/a.* through to it.
RAVENDB_PORT="${RAVEN_QUILL_RAVENDB_INTERNAL_PORT:-8443}"
sed -i -E "s#(\"ServerUrl\"[[:space:]]*:[[:space:]]*\")https://[^\"]*(\")#\1https://127.0.0.1:${RAVENDB_PORT}\2#" /app/ravendb/settings.json

NODE_HOST="$(jq -r '.PublicServerUrl' "$SETUP_SETTINGS" | sed -E 's#^https?://##; s#[:/].*##')"
if [ -n "$NODE_HOST" ]; then
    grep -q "[[:space:]]$NODE_HOST\$" /etc/hosts || echo "127.0.0.1 $NODE_HOST" >> /etc/hosts
fi

CERT_DIR=/var/lib/quill/certs
mkdir -p "$CERT_DIR"

PFX="$(basename "$(ls "$SETUP_DIR"/A/cluster.server.certificate.*.pfx | head -n1)")"
[ -f "$CERT_DIR/$PFX" ] || cp "$SETUP_DIR/A/$PFX" "$CERT_DIR/"

sed -i "s#\"$PFX\"#\"$CERT_DIR/$PFX\"#" /app/ravendb/settings.json

# The admin client cert's thumbprint is written by the .NET activation service next to the unpacked
# package (it is also our sentinel above). Reading it here rather than extracting from the PFX with
# openssl avoids PKCS#12 bag-ordering quirks and one less binary dependency in the runtime image.
export RAVEN_Security_WellKnownCertificates_Admin="$(cat "$SETUP_DONE")"

# Activate the license shipped in the setup package. The setup-wizard zip writes license.json at the
# package root (not into A/settings.json), and nothing else wires it up — without this RavenDB starts
# unlicensed (Community/AGPL) and rejects commercial features (AI Agent, etc.), even though a valid
# license sits on disk. License.Eula.Accepted is re-asserted because A/settings.json carries no Eula
# flag, and a missing flag blocks activation.
if [ -f "$SETUP_DIR/license.json" ]; then
    export RAVEN_License_Path="$SETUP_DIR/license.json"
    export RAVEN_License_Eula_Accepted=true
fi

cd /app/ravendb

exec dotnet /app/ravendb/Raven.Server.dll
