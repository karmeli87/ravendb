{"@metadata": {"@collection": "Endpoints", "@id": "endpoints/1", "@change-vector": "A:1-1", "@last-modified": "2025-11-06T10:26:12.925Z"}, "Path": "/databases/*/stats/essential", "Method": "GET", "Description": "Returns essential database statistics including document count, index count, and storage size.", "Handler": "StatsHandler", "QueryParams": []}
{"@metadata": {"@collection": "Endpoints", "@id": "endpoints/2", "@change-vector": "A:1-2", "@last-modified": "2025-11-06T10:26:12.925Z"}, "Path": "/databases/*/stats/detailed", "Method": "GET", "Description": "Returns detailed database statistics with comprehensive metrics including all collection stats, index statistics, storage breakdown, document counts per collection, and performance data. More verbose than /stats endpoint.", "Handler": "StatsHandler", "QueryParams": []}
{"@metadata": {"@collection": "Endpoints", "@id": "endpoints/3", "@change-vector": "A:1-3", "@last-modified": "2025-11-06T10:26:12.925Z"}, "Path": "/databases/*/stats", "Method": "GET", "Description": "Returns general database statistics including document count, index count, database size, last document etag, and cluster information. Essential for monitoring database health and size.", "Handler": "StatsHandler", "QueryParams": []}
