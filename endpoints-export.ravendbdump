{"@metadata": {"@collection": "Endpoints", "@id": "endpoints/8", "@change-vector": "A:1-8", "@last-modified": "2025-11-06T10:26:12.925Z"}, "Path": "/databases/*/queries", "Method": "GET", "Description": "Executes a RQL (Raven Query Language) query and returns matching documents. Supports projections, filtering, ordering, and includes.", "Handler": "QueriesHandler", "QueryParams": [{"Name": "query", "Required": true, "Description": "The RQL query string to execute.", "Type": "string", "DefaultValue": null}, {"Name": "start", "Required": false, "Description": "Number of results to skip for pagination.", "Type": "int", "DefaultValue": "0"}, {"Name": "pageSize", "Required": false, "Description": "Maximum number of results to return.", "Type": "int", "DefaultValue": null}, {"Name": "waitForNonStaleResults", "Required": false, "Description": "Wait for non-stale results before returning.", "Type": "bool", "DefaultValue": "false"}, {"Name": "waitForNonStaleResultsTimeout", "Required": false, "Description": "Maximum time to wait for non-stale results.", "Type": "TimeSpan", "DefaultValue": null}]}
